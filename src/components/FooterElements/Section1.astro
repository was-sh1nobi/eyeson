---
import { Mailbox, MapPin } from "@lucide/astro";
import InstagramIcon from "../icons/InstagramIcon.astro";
---

<div class="flex flex-col gap-8 md:gap-10 max-w-xs md:max-w-sm">

    <!-- logo -->
    <div class="flex justify-center md:justify-start">
        <img
                src="/logo.webp"
                alt="Logo"
                class="h-16 w-auto object-contain transition-transform duration-300 hover:scale-105"
                loading="lazy"
        />
    </div>

    <!-- headline -->
    <div class="text-lg md:text-xl font-medium text-white text-center md:text-left">
        Lets create something extraordinary together
    </div>

    <!-- contact info -->
    <div class="flex flex-col gap-3">

        <a href="https://instagram.com/EyesonStudio" target="_blank" rel="noreferrer" class="flex items-center gap-3 text-white text-sm md:text-base cursor-pointer hover:text-teal-400 transition-colors duration-300">
            <InstagramIcon class="min-w-6 text-[#46B6A0]" size={24} />
            <span>@EyesonStudio</span>
        </a>

        <a href="mailto:hello@eyesonstudio.com" class="flex items-center gap-3 text-white text-sm md:text-base cursor-pointer hover:text-teal-400 transition-colors duration-300">
            <Mailbox class="min-w-6 text-[#46B6A0]" size={24} />
            <span>hello@eyesonstudio.com</span>
        </a>

        <a href="https://www.google.com/maps/search/?api=1&query=Tbilisi%2C%20Georgia" target="_blank" rel="noreferrer" class="flex items-center gap-3 text-white text-sm md:text-base cursor-pointer hover:text-teal-400 transition-colors duration-300">
            <MapPin class="min-w-6 text-[#46B6A0]" size={24} />
            <span>Tbilisi, Georgia, <br> Remote studio, working with clients worldwide</span>
        </a>

    </div>

</div>
