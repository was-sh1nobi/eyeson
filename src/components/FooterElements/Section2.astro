---
import { ArrowRight, Send, MessageCircle } from "@lucide/astro";
import InstagramIcon from "../icons/InstagramIcon.astro";
import YoutubeIcon from "../icons/YoutubeIcon.astro";
---

<div class="flex flex-col md:flex-col gap-8 md:gap-10 max-w-xs md:max-w-sm">

    <!-- newsletter -->
    <div class="flex flex-col gap-4">

        <h2 class="text-xl font-semibold text-[#46B6A0]">
            STAY UPDATED
        </h2>

        <div class="flex bg-white/5 rounded-xl p-3 md:p-4 gap-2 items-center">

            <label class="w-full min-w-0">
                <input
                        type="email"
                        placeholder="Your Email"
                        class="w-full min-w-0 flex-1 bg-transparent border-none outline-none text-white placeholder:text-gray-400 text-sm md:text-base"
                />
            </label>

            <ArrowRight
                    class="text-white cursor-pointer hover:text-[#46B6A0] transition-colors duration-300"
                    size={24}
            />

        </div>

        <a
                href="/privacy"
                class="text-sm md:text-base underline decoration-white underline-offset-2 hover:text-[#46B6A0] transition-colors duration-300"
        >
            Privacy Policy
        </a>

    </div>

    <!-- social icons -->
    <div class="flex gap-5 justify-start">

        <a href="https://youtube.com/@EyesonStudio" target="_blank" rel="noreferrer" aria-label="YouTube" class="text-white cursor-pointer hover:text-red-500 transition-colors duration-300">
            <YoutubeIcon size={36} />
        </a>

        <a href="https://t.me/EyesonStudio" target="_blank" rel="noreferrer" aria-label="Telegram" class="text-white cursor-pointer hover:text-[#0088cc] transition-colors duration-300">
            <Send size={36} />
        </a>

        <a href="/contact" aria-label="WhatsApp" class="text-white cursor-pointer hover:text-[#25D366] transition-colors duration-300">
            <MessageCircle size={36} />
        </a>

        <a href="https://instagram.com/EyesonStudio" target="_blank" rel="noreferrer" aria-label="Instagram" class="text-white cursor-pointer hover:text-pink-500 transition-colors duration-300">
            <InstagramIcon size={36} />
        </a>

    </div>

</div>
