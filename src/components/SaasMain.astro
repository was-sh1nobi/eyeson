---
import ContactUs from "../islands/ContactUs";
import FeaturesSection from "./Shared/FeaturesSection.astro";
import LogoCaro from "./Shared/LogoCaro.astro";
import StarBackground from "../islands/StarBackground";
import SaasEditingSection from "../islands/saas/SaasEditingSection";
import CostSaas from "./Shared/CostSaas.astro";
import {SaasNeedsBlock} from "../islands/saas/SaasNeedsBlock.tsx";
import SaasServicesVideoStyle from "../islands/saas/SaasServicesVideoStyle";
import CaseStudiesSection from "../islands/CaseStudiesSection";
import ApproachTimelineSection from "../islands/Video/ApproachTimelineSection";
import VideoWorkShowcaseSection from "../islands/Shared/VideoWorkShowcaseSection";
import SaasPackagesSection from "../islands/saas/SaasPackagesSection";
import SaasWhatsIncludedSection from "../islands/saas/SaasWhatsIncludedSection";
import QandASection from "./Shared/QandASection.astro";
import HomeBackground from "./Home/HomeBackground.astro";
import SaasBackground from "./Saas/SaasBackground.astro";
import { VideoHeader } from "../islands/Shared/VideoHeader";

const qas = [
  {
    id: 1,
    q: "What is the difference between a SaaS trailer and a product explainer?",
    a: "A SaaS trailer is usually shorter, faster, and more cinematic. Its main goal is to create excitement, communicate the core value quickly, and make the product feel premium. A product explainer goes deeper into the problem, solution, features, workflow, and benefits, giving viewers a clearer understanding of how the software works.",
  },
  {
    id: 2,
    q: "How long should my SaaS video be?",
    a: "It depends on the goal. Most SaaS trailers work best between 30–60 seconds, while product explainers are typically around 60–90 seconds. Product demos or more detailed walkthroughs can be longer when the product requires additional explanation. We help determine the right length based on your audience, platform, and message.",
  },
  {
    id: 3,
    q: "Do you help with the script and concept?",
    a: "Yes. We can handle the entire creative process from the initial concept to the final video. We study your product, audience, positioning, features, and goals before developing the core idea, structure, messaging, script, and visual direction.",
  },
  {
    id: 4,
    q: "What do you need from us to get started?",
    a: "Usually, we need access to your website or product, brand guidelines if available, logo files, UI designs or screenshots, key features, target audience, and any visual references you like. If you do not have everything prepared, we can still guide the project and identify exactly what is needed during the discovery stage.",
  },
  {
    id: 5,
    q: "Can you animate our actual product UI?",
    a: "Yes. UI animation is one of the core parts of our SaaS video production. We can animate dashboards, mobile apps, websites, product screens, workflows, interactions, charts, notifications, menus, and other interface elements to make the product feel smooth, intuitive, and premium.",
  },
  {
    id: 6,
    q: "Can you create the video if our product is not fully launched yet?",
    a: "Yes. We can work with Figma designs, prototypes, screenshots, mockups, early product builds, and design files to create a polished product video before the final software is publicly available. This is especially useful for launches, fundraising, waitlists, and pre-release campaigns.",
  },
  {
    id: 7,
    q: "Do you provide voiceover and sound design?",
    a: "Yes. Depending on the project, we can include professional AI or human voiceover, sound effects, music, transitions, and complete sound design to make the final video feel more immersive and polished. Videos can also be created without voiceover when a typography and UI-driven approach works better.",
  },
  {
    id: 8,
    q: "How does the revision process work?",
    a: "We share the video during key production stages so feedback can be incorporated efficiently. Revisions can include adjustments to pacing, animation, typography, UI presentation, messaging, transitions, sound, and other production details depending on the scope of the project. Our goal is to make sure the final video feels aligned with both your product and your brand.",
  },
  {
    id: 9,
    q: "Can you create multiple versions for different platforms?",
    a: "Yes. We can prepare different formats, durations, and variations for your website, LinkedIn, X, Instagram, TikTok, YouTube, Meta Ads, presentations, and other platforms. We can also create shorter cutdowns from the main video for advertising and social campaigns.",
  },
  {
    id: 10,
    q: "How much does a SaaS trailer or explainer cost?",
    a: "Pricing depends on the video length, animation complexity, UI requirements, visual style, voiceover, number of scenes, and overall production scope. Once we understand your product and what you want to create, we can recommend the right production package and provide a clear quote before the project begins.",
  },
];
---


<main class="relative w-full min-h-screen overflow-hidden">


        <HomeBackground />
        <SaasBackground />
        <StarBackground />


    <VideoHeader

    topText="SAAS TRAILERS · PRODUCT EXPLAINERS · UI MOTION · PRODUCT DEMOS"
    BeforeHighlight="Make Your Software"
    Highlight="Impossible to Ignore."
    AfterHighlight=""
    Description="We create premium SaaS trailers and product explainers that turn complex software into clear, engaging stories. From cinematic launch videos to UI-driven explainers, every video is built to communicate value fast, showcase the product beautifully, and move viewers toward action."


    imageUrl="/saas/right-hero-c2.webp"
    imageDivClassName=" md:scale-[1.2] "
    imageClassName="scale-[1.2]"
    primaryBtnText="Start Your Video"
    primaryBtnUrl="/contact"
    secondaryBtnText="See Our Work"
    secondaryBtnUrl="/portfolio"


    enableImageHover={true}


    showBackground={true}
    backgroundClassName="
    bg-[linear-gradient(to_bottom,#010e17_0%,#01343a_35%,#34776c_65%,rgba(52,119,108,0.6)_80%,rgba(52,119,108,0.25)_90%,transparent_100%)]
    "
    

    headingClassName="text-3xl sm:text-3xl lg:text-4xl font-extrabold"
    highlightClassName="text-[#39d0c3]"

    textContainerClassName="space-y-5"


    primaryBtnWrapperClassName="bg-gradient-to-r from-[#0fe0d2] to-[#08717e] p-[2px] rounded-full"
    primaryBtnClassName="bg-gradient-to-r from-[#00A9BD] to-[#1D553A] text-white px-6 py-3"

    secondaryBtnWrapperClassName="bg-gradient-to-r from-[#08717e] to-[#40ae90] p-[2px] rounded-full"
    secondaryBtnClassName="bg-gradient-to-r from-[#00061D] to-[#0B1F2A] text-white px-6 py-3"


    imageWrapperClassName="rounded-3xl overflow-hidden w-80 md:w-140"
    client:idle
    />
    <LogoCaro tagline="Trusted by SaaS teams, startups, and product-led brands worldwide." />
    <SaasEditingSection client:visible/>
    <FeaturesSection
      badgeText=""
      title="Excellence in SaaS"
      highlight="Trailers & Explainers"
      description="Every video is designed to do more than look polished. We make your product easier to understand, more exciting to experience, and stronger at converting attention into interest."
      features={[
        { id: 1, title: "Clear Product Storytelling", description: "We turn features, workflows, and technical ideas into a simple narrative that helps viewers quickly understand what your product does and why they should care." },
        { id: 2, title: "Premium UI Animation", description: "Your interface becomes part of the story. We animate dashboards, apps, screens, interactions, and product flows in a polished way that makes the software feel intuitive and high-end." },
        { id: 3, title: "Conversion Focused Structure", description: "Every scene has a purpose. We structure the video around the problem, product value, key benefits, proof, differentiation, and the action you want viewers to take." },
        { id: 4, title: "Custom Visual Direction", description: "No generic templates or disconnected animation styles. We build the visual direction around your product, brand identity, audience, positioning, and campaign goals." },
        { id: 5, title: "Script to Final Video", description: "From the first idea to the finished export, we can handle the entire production process including concept, script, storyboard, UI preparation, animation, voiceover, sound, and final delivery." },
        { id: 6, title: "Built for Modern SaaS", description: "We create videos for AI products, SaaS platforms, apps, fintech, productivity tools, developer products, B2B software, marketplaces, and the next generation of digital products." },
      ]}
    />
    <SaasNeedsBlock client:visible />
    <SaasServicesVideoStyle client:visible/>
    <SaasWhatsIncludedSection client:visible/>
    <ApproachTimelineSection
      eyebrow="OUR PROCESS"
      title="Our Approach to SaaS Video Production"
      description="We handle the entire process from understanding your product to delivering the final video, with every stage built around clarity, storytelling, and premium execution."
      client:visible
    />
    <VideoWorkShowcaseSection
      eyebrow="SEE THE WORK"
      title="SaaS Videos That Make People"
      highlight="Stop Scrolling."
      description="Explore SaaS trailers, product explainers, UI motion, feature demos, and launch videos crafted to turn complex software into clear, engaging visual stories."
      client:visible
    />
    <SaasPackagesSection client:visible/>
    <CaseStudiesSection client:visible />
    <CostSaas  />
    <QandASection
      questions={qas}
      title1="Everything You Need to Know"
      title2="Before Starting Your SaaS Video"
      description="From timelines and pricing to scripts, UI files, revisions, and deliverables, here are the most common questions we get about SaaS trailers and product explainer videos."
    />
    <ContactUs client:visible />

</main>
