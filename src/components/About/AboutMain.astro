<div class="relative bg-[#000E17]">
  <HomeBackground />
  <Hero />
  <OrbitSystem
    orbits={orbits}
    content={content}
    width="1000px"
    height="1000px"
    animations={true}
    client:visible
  />
  <Communication />
  <ToolsComponent client:visible />
  <VideoWorkShowcaseSection
    client:visible
    eyebrow="OUR WORK"
    title="Who we work with"
    highlight={null}
    description="At EyesOn Studio, we work with businesses of all sizes, industries, and stages of growth.
From startups and SaaS companies to established brands, agencies, ecommerce
businesses, service providers, and enterprise teams, our work is never limited to a single
niche. Every project is approached with a fresh perspective and tailored to the unique
goals, audience, and challenges of the brand behind it.
Whether you're launching a new product, building a stronger brand presence, creating
marketing campaigns, improving your digital experience, or producing engaging visual
content, we adapt our creative process to fit your needs.
No two brands are the same, and that's exactly how we like it. Our flexibility, collaborative
approach, and multidisciplinary team allow us to take on a wide range of creative
challenges while delivering work that feels customized, relevant, and aligned with your
vision."
    sectionClassName="pt-4 sm:pt-6 lg:pt-8"
    titleClassName="mt-3 text-4xl font-bold leading-tight text-[#2bd0c7] sm:mt-4 sm:text-5xl lg:text-6xl"
    descriptionClassName="mx-auto mt-4 max-w-3xl text-sm leading-7 text-[#b9c8d0] sm:mt-5 sm:text-base"
    fadeColor="#000E17"
  />
  <QandASection />
  <ContactUs client:visible />
  <FinalCta
    client:visible
    kicker="READY TO START?"
    title="Let Your Story Move People."
    description="Tell us what you're building — we'll bring it to life with motion."
    primaryText="Start a Motion Project"
    primaryHref="/contact"
    secondaryText="View Our Work"
    secondaryHref="/portfolio"
  />
</div>
