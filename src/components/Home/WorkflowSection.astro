---
import { SmartImage } from "@/utils/SmartImage";

interface CardItem {
  title: string;
  description: string;
  buttonText: string;
  imageUrl: string;
}

interface Props {
  headingTop?: string;
  headingBottom?: string;
  description?: string;
  cards?: CardItem[];
}

const {
  headingTop = "A Clear Process",
  headingBottom = "for Smooth Creative Delivery",
  description = "From first idea to final files, our workflow keeps every project organized, fast, and easy to follow.",
  cards = [
    {
      title: "Creative Discovery",
      description: "We start by understanding your brand, goals, audience, and project needs, so the direction is clear before any design, editing, or animation begins.",
      buttonText: "Start the Process",
      imageUrl: "/home/frame1.webp"
    },
    {
      title: "Planning & Creative Direction",
      description: "We shape the message, structure, visual style, and production plan. This keeps every video, animation, or design asset aligned before execution starts.",
      buttonText: "Plan Your Project",
      imageUrl: "/home/frame2.webp"
    },
    {
      title: "Production & Final Delivery",
      description: "Once the direction is approved, we move into production, keep you updated, apply feedback, and deliver polished final files ready for launch, social media, ads, or your website.",
      buttonText: "Get Final Files",
      imageUrl: "/home/frame3.webp"
    }
  ],
} = Astro.props;
---

<section class="relative overflow-hidden py-16 sm:py-20 lg:py-28 [content-visibility:auto] [contain-intrinsic-size:auto_800px]">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center mb-12 sm:mb-16">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
        <span class="block bg-gradient-to-r from-[var(--primitive-teal-400)] via-[#60d6c6] to-[var(--primitive-teal-400)] bg-[length:200%_auto] animate-gradient bg-clip-text text-transparent pb-1">
          {headingTop}
        </span>
        <span class="block mt-1">
          {headingBottom}
        </span>
      </h2>

      <p class="mt-4 text-sm sm:text-base leading-relaxed text-white/60 max-w-xl mx-auto font-light">
        {description}
      </p>
    </div>

    <!-- Cards Grid (Clean Responsive 3-Column Layout on Desktop & Tablet) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      {cards.map((card, idx) => (
        <article
          class="workflow-card group relative flex flex-col overflow-hidden rounded-[28px] border border-white/10 bg-gradient-to-b from-[#061e27]/90 to-[#020d13]/95 p-5 sm:p-6 shadow-2xl backdrop-blur-xl transition-all duration-300 hover:border-[#00E6D7]/40 hover:-translate-y-1.5 hover:shadow-[0_20px_50px_rgba(0,169,189,0.18)] reveal-on-scroll"
          style={`transition-delay: ${idx * 120}ms;`}
        >
          {/* Subtle Top Glow */}
          <div class="pointer-events-none absolute top-0 inset-x-0 h-24 bg-gradient-to-b from-[#00E6D7]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

          {/* Cursor Spotlight — هاله نور دنبال‌کننده موس */}
          <div class="card-spotlight pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>

          {/* Illustration Container — Natural Contain without Stretching */}
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-[#03131b] border border-white/[0.06] p-2 flex items-center justify-center mb-6">
            <SmartImage
              src={card.imageUrl}
              alt={card.title}
              objectFit="contain"
              fill={true}
              loading="lazy"
              className="w-full h-full object-contain transition-transform duration-500 scale-140 group-hover:scale-142"
            />
          </div>

          {/* Text Content */}
          <div class="flex flex-1 flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono uppercase tracking-widest text-[#00E6D7] mb-2 font-semibold">
                Step 0{idx + 1}
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-white transition-colors group-hover:text-[#00E6D7] mb-3">
                {card.title}
              </h3>
              <p class="text-sm leading-relaxed text-white/70 font-light">
                {card.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-white/5">
              <a
                href="/contact"
                class="inline-flex items-center justify-center rounded-xl bg-white/5 border border-white/10 px-5 py-2.5 text-xs sm:text-sm font-semibold text-white/90 transition-all duration-200 hover:bg-[#00E6D7] hover:text-black hover:border-transparent hover:shadow-[0_0_20px_rgba(0,230,215,0.4)] active:scale-95 w-full text-center"
              >
                {card.buttonText}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .animate-gradient {
    animation: gradient 8s ease infinite;
  }

  /* ================= اسکرول ریویل کارت‌ها ================= */
  .workflow-card.reveal-on-scroll {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 300ms ease,
      box-shadow 300ms ease,
      translate 300ms ease;
    will-change: opacity, transform;
  }

  .workflow-card.reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .workflow-card.reveal-on-scroll {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ================= اسپات‌لایت موس ================= */
  .card-spotlight {
    background: radial-gradient(
      340px circle at var(--mx, 50%) var(--my, 50%),
      rgba(0, 230, 215, 0.10),
      transparent 65%
    );
    z-index: 1;
  }
</style>

<script>
  function initWorkflowMicroInteractions() {
    const cards = document.querySelectorAll<HTMLElement>(".workflow-card");

    // اسکرول ریویل با استگر
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) {
      cards.forEach((c) => c.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              obs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -80px 0px", threshold: 0.1 },
      );
      cards.forEach((c) => observer.observe(c));
    }

    // اسپات‌لایت دنبال‌کننده موس
    const moveSpotlight = (e: Event) => {
      const card = (e.currentTarget as HTMLElement);
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
      card.style.setProperty("--my", `${e.clientY - rect.top}px`);
    };
    cards.forEach((c) => c.addEventListener("pointermove", moveSpotlight));
  }

  document.addEventListener("DOMContentLoaded", initWorkflowMicroInteractions);
  document.addEventListener("astro:page-load", initWorkflowMicroInteractions);
</script>
