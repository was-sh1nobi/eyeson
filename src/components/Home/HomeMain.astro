---
import CreativeDirections from "./CreativeDirections.astro";
import HomeServicesSection from "../../islands/Home/HomeServicesSection";
import QandASection from "../Shared/QandASection.astro";
import VideoWorkShowcaseSection from "../../islands/Shared/VideoWorkShowcaseSection";
import CaseStudiesSection from "../../islands/CaseStudiesSection";
import ContactUs from "../../islands/ContactUs";
import ProcessScrollSection from "../../islands/Home/ProcessScrollSection";
import WhyChooseUs from "./WhyChooseUs.astro";
import TestimonialsSection from "../../islands/Home/TestimonialsSection";
import WorkflowSection from "./WorkflowSection.astro";
import CostVideo from "../Shared/CostVideo.astro";
import HomeBackground from "./HomeBackground.astro";
import HeroHome from "../../islands/Home/HeroHome";
import {type ContentConfig, type OrbitConfig, OrbitSystem} from "../../islands/Shared/OrbitSystem";

import LogoCaro from "../Shared/LogoCaro.astro";

export const content: ContentConfig = {
  headingHighlight: "Global Level",
  headingMain: "Motion & Design",
  headingSecondLine: "without the slow process or high costs",
  subheading: " Backed by years of creative experience, our team delivers polished animations, UI visuals,\n" +
      "product content, and edited videos with the speed of a lean studio, without the delays or\n" +
      "costs of building in-house.",
  buttons: [
    { label: "See our work", link: "/work", className: "bg-linear-to-r from-[#00CFE8] to-[#0D8F79]" },
    { label: "Play showreels", link: "/showreels" },
  ]
};

const orbits: OrbitConfig[] = [
  {
    pathD: "M500,10 a470,470 0 1,0 0,1300 a470,470 0 1,0 0,-1300",
    color: "#00A9BD",
    icons: [
      { name: "crypto-elites", start: -0.1, end: 0.4, iconSrc: "/customers/crypto-elites.webp", iconAlt: "Crypto Elites" },
      { name: "cryptosity", start: 0.35, end: 0.85, iconSrc: "/customers/cryptosisty.webp", iconAlt: "Cryptosity" },
      { name: "predictefy", start: 0.85, end: 1.35, iconSrc: "/customers/predctfy.webp", iconAlt: "Predictefy" },
    ],
  },
  {
    pathD: "M500,110 a370,370 0 1,0 0,1100 a370,370 0 1,0 0,-1100",
    color: "#00A9BD",
    icons: [
      { name: "kraken", start: -0.04, end: 0.46, iconSrc: "/customers/kraken.webp", iconAlt: "Kraken Team" },
      { name: "remora", start: 0.55, end: 1.05, iconSrc: "/customers/remora.webp", iconAlt: "Remora" },
    ],
  },
  {
    pathD: "M500,210 a270,270 0 1,0 0,900 a270,270 0 1,0 0,-900",
    color: "#38B6B3",
    icons: [
      { name: "hey-anon", start: 0.1, end: 0.6, iconSrc: "/customers/hey-anon.webp", iconAlt: "Hey Anon" },
      { name: "nexo", start: 0.65, end: 1.15, iconSrc: "/customers/nexo.png", iconAlt: "Nexo" },
    ],
  },
];
---

<div class="relative flex flex-col gap-3 items-stretch">
  <HomeBackground/>
  <HeroHome client:idle />
  <LogoCaro tagline=""/>
  <CreativeDirections  />
  <OrbitSystem orbits={orbits} content={content} width="1000px" height="1000px" animations={true} client:visible/>
  <HomeServicesSection client:visible />
  <VideoWorkShowcaseSection client:visible />
  <WhyChooseUs />
  <TestimonialsSection client:visible />
  <WorkflowSection
      cards={[
        {
          title: "Creative Discovery",
          description:
              "We start by understanding your brand, goals, audience, and project needs, so the direction is clear before any design, editing, or animation begins.",
          buttonText: "Start the Process",
          imageUrl: "/home/frame1.webp",
        },
        {
          title: "Planning & Creative Direction",
          description:
              "We shape the message, structure, visual style, and production plan. This keeps every video, animation, or design asset aligned before execution starts.",
          buttonText: "Plan Your Project",
          imageUrl: "/home/frame2.webp",
        },
        {
          title: "Production & Final Delivery",
          description:
              "Once the direction is approved, we move into production, keep you updated, apply feedback, and deliver polished final files ready for launch, social media, ads, or your website.",
          buttonText: "Get Final Files",
          imageUrl: "/home/frame3.webp",
        },
      ]}
  />
  <ProcessScrollSection client:visible />


  <CaseStudiesSection client:visible />
  <QandASection  />
  <CostVideo  />
  <ContactUs client:visible />
</div>
