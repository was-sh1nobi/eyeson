  <HeroHome client:idle />
  <LogoCaro tagline=""/>
  <CreativeDirections  />
  <OrbitSystem orbits={orbits} content={content} width="1000px" height="1000px" animations={true} client:visible/>
  <HomeServicesSection client:visible />
  <VideoWorkShowcaseSection client:visible />
  <WhyChooseUs />
  <TestimonialsSection client:visible />
  <WorkflowSection
      cards={[
        {
          title: "Creative Discovery",
          description:
              "We start by understanding your brand, goals, audience, and project needs, so the direction is clear before any design, editing, or animation begins.",
          buttonText: "Start the Process",
          imageUrl: "/Shared/Features/left.webp",
        },
        {
          title: "Planning & Creative Direction",
          description:
              "We shape the message, structure, visual style, and production plan. This keeps every video, animation, or design asset aligned before execution starts.",
          buttonText: "Plan Your Project",
          imageUrl: "/Shared/Features/middle.webp",
        },
        {
          title: "Production & Final Delivery",
          description:
              "Once the direction is approved, we move into production, keep you updated, apply feedback, and deliver polished final files ready for launch, social media, ads, or your website.",
