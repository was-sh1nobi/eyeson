---
import { SmartImage } from "@/utils/SmartImage";
import PrimaryButton from "../Shared/PrimaryButton";
import SecondaryButton from "../Shared/SecondaryButton";

interface Props {
  eyebrow?: string;
  title?: string;
  highlight?: string;
  description?: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  eyebrow = "Why choose us",
  title = "A complete creative team\n" +
      "for less than hiring one designer",
  highlight = "",
  description = "Get motion designers, animators, editors, and visual designers working together as one\n" +
      "dedicated team. With EyesOn, you get the creative output of a 10+ member in-house team, \n" +
      "backed by years of experience and focused attention to detail, without the delays,\n" +
      "overhead, or stress of building one yourself.",
  primaryText = "Book a Quick Call",
  primaryHref = "/contact",
  secondaryText = "See How It Works",
  secondaryHref = "/portfolio",
} = Astro.props;
---

<section class="relative py-[var(--space-2xl)] sm:py-[var(--space-3xl)] lg:py-[var(--space-3xl)] overflow-hidden">
  <div class="relative mx-auto flex w-full max-w-[var(--container-max)] flex-col lg:flex-row lg:items-center lg:justify-between px-[var(--space-gutter)] sm:px-[var(--space-gutter-md)] lg:px-[var(--space-gutter-lg)]">
    

    
    <div class="grid grid-cols-1 lg:grid-cols-2 w-full gap-8 lg:gap-12 items-center text-center lg:text-left">


      <div class="flex flex-col items-center lg:items-start order-1">
        {/* Eyebrow — glass hairline per Modern Dark */}
        <div
          class=" mb-6 inline-flex items-center gap-3 rounded-full border border-[var(--color-border)] bg-white/[0.04] px-4 py-2.5 sm:py-2 shadow-[var(--elevation-1)] backdrop-blur-md group"
          style="background: linear-gradient(135deg, rgba(17,86,95,0.32) 0%, rgba(11,31,42,0.36) 100%);"
        >
          <span class="relative flex h-2.5 w-2.5 sm:h-3 sm:w-3">
            <span class="relative inline-flex rounded-full h-full w-full bg-[var(--primitive-teal-400)] shadow-[0_0_10px_rgba(47,208,200,0.7)] motion-safe:group-hover:shadow-[0_0_14px_rgba(47,208,200,0.9)] transition-shadow duration-[var(--duration-normal)]"></span>
            <span class="absolute inset-0 rounded-full bg-[var(--primitive-teal-400)] opacity-0 motion-safe:animate-[softPulse_2.8s_ease-in-out_infinite]" aria-hidden="true"></span>
          </span>
          <span class="text-caption text-white/80 normal-case tracking-normal">{eyebrow}</span>
        </div>

        <h2 class=" max-w-xl text-h2 leading-[1.12] text-white">
          {title}
          {highlight && (
            <span class="block mt-1 bg-gradient-to-r from-[var(--primitive-teal-400)] to-[var(--primitive-teal-600)] bg-clip-text text-transparent">
              {highlight}
            </span>
          )}
        </h2>

        <p class="mt-4 lg:mt-5 max-w-xl text-small leading-relaxed text-white/65 mx-auto lg:mx-0 font-light">
          {description}
        </p>

        <div class="mt-6 lg:mt-8 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start items-center w-full sm:w-auto">
          <div class="relative group/btn transform-gpu transition-transform duration-[var(--duration-normal)] ease-[var(--ease-default)] hover:scale-[1.02] active:scale-[0.98] w-full sm:w-auto">
            <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-[var(--primitive-teal-400)] to-[var(--primitive-teal-600)] opacity-0 blur-lg transition-opacity duration-[var(--duration-slow)] group-hover/btn:opacity-30" aria-hidden="true"></div>
            <div class="relative flex justify-center w-full">
              <div class="w-[16rem] sm:w-auto">
                <PrimaryButton text={primaryText} href={primaryHref} width="100%" height="50px" />
              </div>
            </div>
          </div>

          <div class="relative group/btn transform-gpu transition-transform duration-[var(--duration-normal)] ease-[var(--ease-default)] hover:scale-[1.02] active:scale-[0.98] w-full sm:w-auto">
            <div class="relative flex justify-center w-full">
              <div class="w-[16rem] sm:w-auto">
                <SecondaryButton text={secondaryText} href={secondaryHref} width="100%" height="50px" />
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* 2. ستون تصویر */}
      <div class="w-full order-2">
        <div class="relative mx-auto w-full max-w-md lg:max-w-xl motion-safe:animate-[softFloat_7s_ease-in-out_infinite] group will-change-transform">
          <div class="relative transform-gpu transition-transform duration-[var(--duration-slower)] ease-[var(--ease-default)] group-hover:scale-[1.02] group-hover:-translate-y-1">
            <SmartImage
              src="/home/new-svgs/multiple-icon.svg"
              alt="Why choose us visual"
              loading="lazy"
              className="drop-shadow-[0_20px_40px_rgba(0,0,0,0.4)] group-hover:drop-shadow-[0_24px_48px_rgba(20,150,150,0.22)] transition-[filter] duration-[var(--duration-slower)] ease-[var(--ease-default)]"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes softFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @keyframes softPulse {
    0%, 100% { opacity: 0; transform: scale(1); }
    50% { opacity: 0.22; transform: scale(1.55); }
  }

  html.js .reveal-on-scroll {
    opacity: 0;
  }

  

  

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translate(0);
  }

  .delay-100 { transition-delay: 0.1s; }
  .delay-200 { transition-delay: 0.2s; }
  .delay-300 { transition-delay: 0.3s; }
  .delay-400 { transition-delay: 0.4s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .motion-safe\:animate-\[softFloat_7s_ease-in-out_infinite\],
    .motion-safe\:animate-\[softPulse_2\.8s_ease-in-out_infinite\] {
      animation: none !important;
    }
  }
</style>

<script is:inline>
  function initWhyUsAnimations() {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const elements = document.querySelectorAll(".reveal-on-scroll");

    if (
      prefersReducedMotion ||
      document.documentElement.classList.contains("gpu-off") ||
      typeof IntersectionObserver === "undefined"
    ) {
      elements.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        rootMargin: "0px 0px -50px 0px",
        threshold: 0.1,
      },
    );

    elements.forEach((el) => observer.observe(el));
  }

  document.addEventListener("DOMContentLoaded", initWhyUsAnimations);
  document.addEventListener("astro:page-load", initWhyUsAnimations);
</script>