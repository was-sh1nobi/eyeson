---
import { SmartImage } from "@/utils/SmartImage";
import PrimaryButton from "../Shared/PrimaryButton";

interface Props {
  titleLine1?: string;
  titleLine2?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
  imageUrl?: string;
}

const {
  titleLine1 = "We turn raw ideas into",
  titleLine2 = "powerful creative visuals",
  description = "We turn your ideas and products into clear, creative visuals that make people stop and pay\n" +
      "attention. From video editing and animation to graphic design, branding, and storytelling,\n" +
      "our team helps your product look better, communicate faster, and stand out in a world full\n" +
      "of content.",
  buttonText = "See our work",
  imageUrl = "/home/new-svgs/after-hero-2.webp",
} = Astro.props;
---

<section class="relative w-full overflow-hidden py-[var(--space-lg)] sm:py-[var(--space-xl)]">
  <div class="relative z-10 mx-auto max-w-[var(--container-max)] px-[var(--space-gutter)] sm:px-[var(--space-gutter-md)] lg:px-[var(--space-gutter-lg)]">
    <div
      class="flex flex-col lg:flex-row items-center gap-[var(--space-md)] lg:gap-[var(--space-lg)] xl:gap-[var(--space-xl)]"
    >
      {/* ========================================== */}
      {/* Image Section (با کلاس‌های انیمیشن اسکرول) */}
      {/* ========================================== */}
      <div
        class="w-full lg:w-[55%] flex justify-center lg:justify-start order-1 lg:order-1 mx-auto "
      >
        <div class="cd-tilt-wrap relative w-full group" data-tilt>
          <div
            class="cd-tilt-card relative z-10 w-full transform-gpu transition-transform duration-[var(--duration-emphasis)] ease-[var(--ease-default)] flex items-center justify-center mx-auto rounded-[var(--radius-xl)]   overflow-hidden  "
            style="aspect-ratio: 1300 / 1040"
          >
            <SmartImage
              src={imageUrl}
              alt="Creative Directions Concept"
              fill={true}
              className="object-contain drop-shadow-[0_20px_40px_rgba(0,0,0,0.5)] transition-transform duration-[var(--duration-emphasis)] ease-[var(--ease-default)]"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      {/* ========================================== */}
      {/* Text Section (با کلاس‌های انیمیشن اسکرول) */}
      {/* ========================================== */}
      <div
        class="w-full lg:w-[42%] flex flex-col items-center text-center lg:items-start lg:text-left order-2 lg:order-2 "
      >
        <h2
          class="text-h2 mb-4 sm:mb-6"
        >
          <span class="block text-white mb-1">{titleLine1}</span>
          <span
            class="block bg-gradient-to-r from-[var(--primitive-teal-400)] to-[var(--primitive-teal-700)] bg-clip-text text-transparent"
          >
            {titleLine2}
          </span>
        </h2>

        <p
          class="text-lg leading-[1.7] text-white/60 max-w-[48ch] mx-auto lg:mx-0 mb-8 sm:mb-10 font-light"
        >
          {description}
        </p>

        <div class="relative group/btn w-full sm:w-auto">
          <div
            class="absolute -inset-1 rounded-full bg-gradient-to-r from-[var(--primitive-teal-400)] to-[var(--primitive-teal-700)] opacity-0 blur-lg transition-opacity duration-[var(--duration-slow)] group-hover/btn:opacity-30"
            aria-hidden="true"
          >
          </div>

          <div
            class="relative transform-gpu transition-transform duration-[var(--duration-normal)] ease-[var(--ease-default)] group-hover/btn:scale-[1.02] group-active/btn:scale-[0.98]"
          >
            <PrimaryButton text={buttonText} width="14rem" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/* استایل‌های اختصاصی برای انیمیشن‌های اسکرول */}
<style>
  /* ================= تیلت سه‌بعدی تصویر ================= */
  .cd-tilt-wrap {
    perspective: 1100px;
  }

  .cd-tilt-card {
    transform: rotateX(0deg) rotateY(0deg) scale(1);
    transition: transform 0.35s ease-out;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .cd-tilt-card {
      transition: none;
    }
  }
</style>

{/* اسکریپت سبک Intersection Observer برای هندل کردن اسکرول */}
<script>
  function initScrollAnimations() {
    // ترجیحات کاربر (اگر انیمیشن رو خاموش کرده باشه)
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const elements = document.querySelectorAll(".reveal-on-scroll");

    if (
      prefersReducedMotion ||
      document.documentElement.classList.contains("gpu-off") ||
      typeof IntersectionObserver === "undefined"
    ) {
      // اگر کاربر انیمیشن نمی‌خواد، همون اول همه رو نشون بده
      elements.forEach((el) => el.classList.add("is-visible"));
    } else {
      const observerOptions = {
        root: null,
        rootMargin: "0px 0px -100px 0px", // انیمیشن وقتی شروع میشه که 100 پیکسل از پایین صفحه بیاد بالا
        threshold: 0.1,
      };

      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            // وقتی یه بار نشون داده شد، دیگه مانیتورش نکن تا پرفورمنس بالا بمونه
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      elements.forEach((el) => observer.observe(el));
    }

    // تیلت سه‌بعدی تصویر دنبال‌کننده موس
    const wrap = document.querySelector("[data-tilt]");
    const card = wrap?.querySelector(".cd-tilt-card");
    if (wrap && card && !prefersReducedMotion && !window.matchMedia("(pointer: coarse)").matches) {
      let raf = 0;
      let pendingEvent: PointerEvent | null = null;
      let rect: DOMRect | null = null;

      const updateTilt = () => {
        raf = 0;
        if (!pendingEvent || !rect) return;
        const px = (pendingEvent.clientX - rect.left) / rect.width - 0.5;
        const py = (pendingEvent.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `rotateX(${py * -7}deg) rotateY(${px * 9}deg) scale(1.015)`;
      };

      const onEnter = () => {
        rect = wrap.getBoundingClientRect();
      };

      const onMove = (e: Event) => {
        pendingEvent = e as PointerEvent;
        if (!rect) rect = wrap.getBoundingClientRect();
        if (!raf) {
          raf = requestAnimationFrame(updateTilt);
        }
      };

      const onLeave = () => {
        if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
        pendingEvent = null;
        rect = null;
        card.style.transform = "rotateX(0deg) rotateY(0deg) scale(1)";
      };

      wrap.addEventListener("pointerenter", onEnter, { passive: true });
      wrap.addEventListener("pointermove", onMove, { passive: true });
      wrap.addEventListener("pointerleave", onLeave, { passive: true });
    }
  }

  // اجرای اسکریپت با پشتیبانی از Astro View Transitions
  document.addEventListener("DOMContentLoaded", initScrollAnimations);
  document.addEventListener("astro:page-load", initScrollAnimations);
</script>
