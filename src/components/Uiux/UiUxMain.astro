---
import CaseStudiesSection from "../../islands/CaseStudiesSection";
import ContactUs from "../../islands/ContactUs";
import UiUxNeed from "../../islands/Shared/UiUxNeed";
import UiUxBackground from "../../islands/UiUx/UiUxBackground";
import HomeBackground from "../Home/HomeBackground.astro";
import ApproachTimelineSection from "../../islands/Video/ApproachTimelineSection";
import FinalCta from "@/islands/Shared/FinalCta";
import UiUxHeroSection from "../../islands/UiUx/UiUxHeroSection";
import LogoCaro from "../Shared/LogoCaro.astro";
import FeaturesSection from "../Shared/FeaturesSection.astro";
import UiUxServicesSection from "../../islands/UiUx/UiUxServicesSection";
import UiUxExcellenceSection from "./UiUxExcellenceSection.astro";
import UiUxPricingSlider from "../../islands/UiUx/UiUxPricingSlider";
import UiUxAppSlider from "../../islands/UiUx/UiUxAppSlider";
import { SplineScene } from "@/islands/About/SplineAboutPage";
import PrimaryButton from "../Shared/PrimaryButton";
import {VideoHeader} from "@/islands/Shared/VideoHeader.tsx";

const features = [
  {
    id : 1,
    title : "User First Approach",
    description : "Every design decision is made with real users in mind, creating experiences that feel\n" +
        "natural and easy to navigate.",
    bgImage : "/Shared/Features/1.webp"
  },
  {
    id : 2,
    title : "SaaS & Product Focused",
    description : "From startups to growing platforms, we design interfaces tailored for modern SaaS and\n" +
        "digital products.",
    bgImage : "/Shared/Features/1.webp"
  },
  {
    id : 3,
    title : "Built for Scalability",
    description : "Design systems and interfaces structured to grow with your product and team.",
    bgImage : "/Shared/Features/1.webp"
  },
  {
    id : 4,
    title : "Conversion Focused",
    description : "Landing pages and user flows designed to guide visitors toward meaningful actions.",
    bgImage : "/Shared/Features/1.webp"
  },
  {
    id : 5,
    title : "Clean & Intuitive Design",
    description : "Modern interfaces that simplify complex information and improve usability."
  },
  {
    id : 6,
    title : "Collaborative Process",
    description : "Transparent communication, structured feedback, and a streamlined workflow from\n" +
        "concept to delivery.",
    bgImage : "/Shared/Features/1.webp"
  },
]

---

<div class="relative flex flex-col gap-3 justify-center items-between">
  <HomeBackground />


  <VideoHeader
      topText="DESIGNED FOR USERS · BUILT FOR SCALE"
      BeforeHighlight=""
      Highlight="UI/UX Design"
      AfterHighlight={`for SaaS & Digital Products`}
      Description="Designing websites, landing pages, and product interfaces that users understand and
            teams can scale."


      imageUrl="/uiux/RightElement/22.webp"


      primaryBtnText="Request Proposal"

      primaryBtnUrl="/contact"
      secondaryBtnText="Book a Call"
      secondaryBtnUrl="/contact"


      enableImageHover={true}


      showBackground={true}
      backgroundClassName="
    bg-[linear-gradient(to_bottom,#010e17_0%,#01343a_35%,#34776c_65%,rgba(52,119,108,0.6)_80%,rgba(52,119,108,0.25)_90%,transparent_100%)]
    "


      headingClassName="text-3xl sm:text-3xl lg:text-4xl font-extrabold"
      highlightClassName="text-[#39d0c3]"

      textContainerClassName="space-y-5"


      primaryBtnWrapperClassName="bg-gradient-to-r from-[#0fe0d2] to-[#08717e] p-[2px] rounded-full"
      primaryBtnClassName="bg-gradient-to-r from-[#00A9BD] to-[#1D553A] text-white px-6 py-3"

      secondaryBtnWrapperClassName="bg-gradient-to-r from-[#08717e] to-[#40ae90] p-[2px] rounded-full"
      secondaryBtnClassName="bg-gradient-to-r from-[#00061D] to-[#0B1F2A] text-white px-6 py-3"


      imageWrapperClassName="rounded-3xl overflow-hidden w-80 md:w-140 !scale-[1.2]"
      client:idle
  />
  <LogoCaro />

  <section class="relative w-full overflow-hidden py-(--space-lg) sm:py-(--space-xl)">
    <div class="relative z-10 mx-auto max-w-(--container-max) px-(--space-gutter) sm:px-(--space-gutter-md) lg:px-(--space-gutter-lg)">
      <div class="flex flex-col lg:flex-row items-center gap-(--space-md) lg:gap-(--space-lg) xl:gap-(--space-xl)">
        {/* Spline Animation Section */}
        <div class="w-full lg:w-[55%] flex justify-center lg:justify-start order-1 lg:order-1 mx-auto">
          <div class="relative w-full group">
            <div class="relative z-10 w-full flex items-center justify-center mx-auto rounded-xl overflow-hidden h-87.5 sm:h-112.5 lg:h-137.5">
              <SplineScene
                scene="https://prod.spline.design/kZDDjO5HuC9GJUM2/scene.splinecode"
                className="w-full h-full object-contain"
                client:visible
              />
            </div>
          </div>
        </div>

        {/* Text Section */}
        <div class="w-full lg:w-[42%] flex flex-col items-center text-center lg:items-start lg:text-left order-2 lg:order-2">
          <h2 class="text-h2 mb-4 sm:mb-6">
            <span class="block text-white mb-1">What is</span>
            <span class="block bg-linear-to-r from-(--primitive-teal-400) to-(--primitive-teal-700) bg-clip-text text-transparent">
              UI/UX design?
            </span>
          </h2>

          <p class="text-lg leading-[1.7] text-white/60 max-w-[48ch] mx-auto lg:mx-0 mb-8 sm:mb-10 font-light">
            UI/UX design is the process of designing the interface and user experience of a digital
            product. It focuses on how your website, app, or platform looks, feels, and functions for the
            people using it.
            Good UI/UX makes navigation intuitive, information easy to understand, and every
            interaction seamless. Whether it's a website, landing page, SaaS platform, or mobile app,
            great design helps users accomplish their goals faster and with less friction.
          </p>

          <div class="relative group/btn w-full sm:w-auto">
            <div
              class="absolute -inset-1 rounded-full bg-linear-to-r from-(--primitive-teal-400) to-(--primitive-teal-700) opacity-0 blur-lg transition-opacity duration-(--duration-slow) group-hover/btn:opacity-30"
              aria-hidden="true"
            >
            </div>
            <div class="relative transform-gpu transition-transform duration-(--duration-normal) ease-(--ease-default) group-hover/btn:scale-[1.02] group-active/btn:scale-[0.98]">
              <PrimaryButton text="See our Work" width="14rem" href="/portfolio" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FeaturesSection
    title="Why Teams Choose EyesOn for"
    highlight="UI/UX design"
    description="We combine strategy, usability, and modern design to create digital experiences that look
great, feel intuitive, and support long term product growth."
    features={features}
  />
  <UiUxServicesSection client:visible />
  <UiUxNeed client:visible />
  <UiUxExcellenceSection />
  <ApproachTimelineSection client:visible />
  <UiUxAppSlider client:visible />
  <CaseStudiesSection client:visible />

  <UiUxPricingSlider client:visible />
  <ContactUs client:visible />
  <FinalCta
    client:visible
    kicker="READY TO START?"
    title="Let Your Story Move People."
    description="Tell us what you're building — we'll bring it to life with motion."
    primaryText="Start a Motion Project"
    primaryHref="/contact"
    secondaryText="View Our Work"
    secondaryHref="/portfolio"
  />
</div>
