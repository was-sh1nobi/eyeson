        description : "Visual storytelling that strengthens your positioning, identity, and perception.",
    },
    {
        id : 5,
        title : "Launch Content",
        description : "Creative assets for product launches, new features, announcements, partnerships, and\n" +
            "campaigns.",
    },
    {
