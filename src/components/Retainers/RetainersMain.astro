---
import ContactUs from "@/islands/ContactUs";
import FeaturesSection from "../Shared/FeaturesSection.astro";
import LogoCaro from "../Shared/LogoCaro.astro";
import StarBackground from "@/islands/StarBackground";
import QandASection from "../Shared/QandASection.astro";

import RetainersBackground from "./RetainersBackground.astro";
import HomeBackground from "../Home/HomeBackground.astro";
import { VideoHeader } from "@/islands/Shared/VideoHeader";
import RetainerCardsGrid from "@/islands/retainers/RetainerCardsGrid";
import RetainerModelSteps from "@/islands/retainers/RetainerModelSteps";
import RetainerContentSystem from "@/islands/retainers/RetainerContentSystem";
import RetainerHowItWorks from "@/islands/retainers/RetainerHowItWorks";
import RetainerPackagesSection from "@/islands/retainers/RetainerPackagesSection";
import RetainerFlexibility from "@/islands/retainers/RetainerFlexibility";
import RetainerFinalCta from "@/islands/retainers/RetainerFinalCta";
import RetainersEditingSection from "@/islands/retainers/RetainersEditingSection";

