        id : 6,
        title : "Established Brands",
        description : "Maintain a consistent production pipeline across campaigns, platforms, products, and\n" +
            "departments.",
    },
]

const funnelContent = [
    {
        id : 1,
        title : "Attention",
        description : "Short-form videos, hooks, social content, brand pieces, and high-impact creative.",
    },
    {
        id : 2,
        title : "Acquisition",
        description : "Paid ads, campaign variations, promotional content, and conversion-focused creatives.",
    },
    {
        id : 3,
        title : "Education",
        description : "Explainers, product videos, tutorials, demos, and feature content.",
    },
    {
        id : 4,
        title : "Conversion",
        description : "Testimonials, product proof, use cases, comparison content, and sales assets.",
    },
    {
        id : 5,
        title : "Retention",
        description : "Product updates, feature announcements, educational content, and community assets.",
    },
    {
