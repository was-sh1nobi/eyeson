---
import ContactUs from "@/islands/ContactUs";
import FeaturesSection from "../Shared/FeaturesSection.astro";
import LogoCaro from "../Shared/LogoCaro.astro";
import CostVideo from "../Shared/CostVideo.astro";
import QandASection from "../Shared/QandASection.astro";
import StarBackground from "@/islands/StarBackground";
import HomeBackground from "../Home/HomeBackground.astro";
import RetainersBackground from "./RetainersBackground.astro";
import { VideoHeader } from "@/islands/Shared/VideoHeader";
import RetainersEditingSection from "@/islands/retainers/RetainersEditingSection";
import { RetainerNeedsBlock } from "@/islands/retainers/RetainerNeedsBlock";
import RetainerServicesSection from "@/islands/retainers/RetainerServicesSection";
import RetainerWhatsIncluded from "@/islands/retainers/RetainerWhatsIncluded";
import ApproachTimelineSection from "@/islands/Video/ApproachTimelineSection";
import VideoWorkShowcaseSection from "@/islands/Shared/VideoWorkShowcaseSection";
import RetainerPackagesSection from "@/islands/retainers/RetainerPackagesSection";
import CaseStudiesSection from "@/islands/CaseStudiesSection";

const features = [
    {
        id : 1,
        title : "Video Production",
        description : "From polished brand videos and product content to short-form social videos, promotional pieces, and campaign creatives.",
    },
    {
        id : 2,
        title : "Motion Design",
        description : "Animated typography, UI motion, product sequences, branded graphics, transitions, visual explainers, and custom motion assets.",
    },
    {
        id : 3,
        title : "Ad Creatives",
        description : "Performance-focused creative for paid campaigns across Meta, LinkedIn, TikTok, YouTube, X, and other acquisition channels.",
    },
    {
        id : 4,
        title : "Social Content",
        description : "Consistent short-form content designed for the platforms where your audience spends its time.",
    },
    {
        id : 5,
        title : "Product Content",
        description : "Feature announcements, product updates, demos, walkthroughs, UI showcases, and launch assets.",
    },
    {
        id : 6,
        title : "Creative Adaptations",
        description : "Turn existing campaigns into new formats, durations, aspect ratios, hooks, variations, and platform-specific versions.",
    },
]

const faqQuestions = [
    {
        id : 1,
        q : "What is an EyesOn monthly retainer?",
        a : "A monthly retainer is an ongoing creative partnership rather than a single project. You reserve production capacity with our team each month, which can be used for agreed types of content such as videos, ads, motion design, product content, social creatives, and campaign assets.",
    },
    {
        id : 2,
        q : "Is the retainer only for video content?",
        a : "No. While video and motion are at the core of EyesOn, retainers can combine different creative needs depending on your plan. This can include editing, motion graphics, UI animation, product videos, short-form content, ad creatives, campaign adaptations, and supporting visual assets.",
    },
    {
        id : 3,
        q : "How many pieces of content do I receive each month?",
        a : "It depends on your retainer level and the complexity of the work. Ten straightforward social edits require very different production capacity from ten advanced motion-design videos. Instead of promising an unrealistic fixed number of deliverables, we define the expected production capacity and content mix before the retainer begins.",
    },
    {
        id : 4,
        q : "Can our content mix change every month?",
        a : "Yes. That flexibility is one of the main advantages of the retainer. For example, one month might focus on short-form social content while another prioritizes ads, a feature launch, and product videos. As long as the workload fits within your monthly production capacity, priorities can be adjusted.",
    },
    {
        id : 5,
        q : "Can you help us decide what content to create?",
        a : "Yes. Depending on your retainer, we can help with concepts, hooks, scripts, references, campaign ideas, content directions, and determining how larger pieces of content can be repurposed across different platforms.",
    },
    {
        id : 6,
        q : "How quickly can you deliver content?",
        a : "Turnaround depends on complexity. Simple edits and adaptations can move significantly faster than advanced motion design, product trailers, or complex UI animation. At the beginning of each production cycle, we prioritize requests and establish realistic delivery expectations.",
    },
    {
        id : 7,
        q : "How do revisions work?",
        a : "Feedback and revisions are built into the production workflow according to the scope of your retainer. We use structured review stages so your team can comment on messaging, pacing, visuals, animation, branding, and other relevant details without creating unnecessary production delays.",
    },
    {
        id : 8,
        q : "Can you follow our existing brand guidelines?",
        a : "Absolutely. We can work within your existing visual identity, typography, colors, motion language, tone, and brand guidelines. Over time, we also build familiarity with your preferences so new content requires less explanation and becomes increasingly consistent.",
    },
    {
        id : 9,
        q : "Can you create content for multiple platforms?",
        a : "Yes. We can produce and adapt content for Instagram, TikTok, LinkedIn, X, YouTube, Meta Ads, websites, presentations, sales channels, and other digital platforms. Where needed, one master creative can also be adapted into multiple aspect ratios, durations, hooks, or versions.",
    },
    {
        id : 10,
        q : "Can we use the retainer for product launches?",
        a : "Yes. Retainers work particularly well for launches because one campaign often requires multiple connected assets—such as a hero video, teaser content, social clips, feature showcases, ads, and shorter campaign variations.",
    },
    {
        id : 11,
        q : "What happens if we need something outside our normal scope?",
        a : "Tell us what you need. If it fits within the team's capabilities and available monthly capacity, we can often incorporate it into production. For significantly larger or specialized projects, we'll scope it separately or recommend adjusting the monthly plan.",
    },
    {
        id : 12,
        q : "Is a monthly retainer better than hiring freelancers?",
        a : "It depends on your needs. For occasional isolated projects, a freelancer may be enough. But when you need consistent content across multiple formats, managing several independent freelancers creates coordination overhead and inconsistent output. A retainer is designed for companies that value continuity, speed, consistency, and reliable production capacity.",
    },
    {
        id : 13,
        q : "Is there a long-term contract?",
        a : "Retainer terms depend on the package and production requirements. We'll clearly define the commitment, monthly capacity, scope, payment terms, and cancellation conditions before the partnership begins—so both sides know exactly how the relationship works.",
    },
    {
        id : 14,
        q : "How do we get started?",
        a : "Tell us about your company, the type of content you currently produce, your channels, expected monthly volume, and what you want to improve. We'll recommend the most appropriate production setup and create a monthly plan around your needs.",
    },
]
---


<main class="relative w-full min-h-screen overflow-hidden">

    <HomeBackground />
    <RetainersBackground />
    <StarBackground />

    <!-- 1. Hero -->
    <VideoHeader

            BeforeHighlight=""
            Highlight="One Creative Partner."
            AfterHighlight={`A Month of Content.`}
            Description="Stop rebuilding your creative team for every new campaign.
EyesOn Studio works as your ongoing content production partner—creating a consistent
stream of premium videos, motion design, product content, ads, social creatives, and
branded visuals every month."

            imageUrl="/retainers/1.webp"
            topText="MONTHLY CONTENT · CREATIVE RETAINERS · ONGOING PRODUCTION"

            primaryBtnText="Start Your Retainer"
            primaryBtnUrl="/contact"
            secondaryBtnText="Explore Our Work"
            secondaryBtnUrl="/portfolio"

            showBackground={true}
            backgroundClassName="
    bg-[linear-gradient(to_bottom,#010e17_0%,#01343a_35%,#34776c_65%,rgba(52,119,108,0.6)_80%,rgba(52,119,108,0.25)_90%,transparent_100%)]
    "

            headingClassName="text-3xl sm:text-3xl lg:text-4xl font-extrabold"
            highlightClassName="text-[#39d0c3]"

            textContainerClassName="space-y-5"

            primaryBtnWrapperClassName="bg-gradient-to-r from-[#0fe0d2] to-[#08717e] p-[2px] rounded-full"
            primaryBtnClassName="bg-gradient-to-r from-[#00A9BD] to-[#1D553A] text-white px-6 py-3"

            secondaryBtnWrapperClassName="bg-gradient-to-r from-[#08717e] to-[#40ae90] p-[2px] rounded-full"
            secondaryBtnClassName="bg-gradient-to-r from-[#00061D] to-[#0B1F2A] text-white px-6 py-3"

            imageWrapperClassName="rounded-3xl overflow-hidden w-100 md:w-120 scale-[1.2] lg:scale-[2.3]"
            client:idle
            />

    <!-- 2. Logo Carousel -->
    <LogoCaro tagline="Trusted by startups, SaaS teams, agencies, and product-led brands that produce content month after month." />

    <!-- 3. Under-hero split section -->
    <RetainersEditingSection client:visible/>

    <!-- 4. Features Grid (shared) -->
    <FeaturesSection features={features} badgeText="MORE THAN A VIDEO SUBSCRIPTION" title="Your External" highlight="Creative Production Team" description="Every retainer is built around what your company actually needs—not a fixed library of generic deliverables."/>

    <!-- 5. Business Needs / Value Prop (replaces RetainerContentSystem) -->
    <RetainerNeedsBlock client:visible />

    <!-- 6. Services/Content Types (replaces contentPossibilities RetainerCardsGrid) -->
    <RetainerServicesSection client:visible/>

    <!-- 7. What's Included / Pipeline (replaces whatWeHandle RetainerCardsGrid) -->
    <RetainerWhatsIncluded client:visible/>

    <!-- 8. Process Timeline (replaces RetainerHowItWorks + RetainerModelSteps) -->
    <ApproachTimelineSection
        eyebrow="A SIMPLE MONTHLY WORKFLOW"
        title="From Monthly Priorities to Finished Content."
        description="Every month follows the same structured process: you share priorities, we develop creative direction, produce the content, collect feedback, refine, and deliver. Then we move straight into the next cycle."
        client:visible />

    <!-- 9. Work Showcase -->
    <VideoWorkShowcaseSection
        eyebrow="SEE THE WORK"
        title="Content We Produce"
        highlight="Every Month"
        description="A sample of the ongoing creative work produced for our retainer clients across video, motion, product content, and ads."
        client:visible />

    <!-- 10. Pricing -->
    <RetainerPackagesSection client:visible/>

    <!-- 11. Case Studies -->
    <CaseStudiesSection client:visible />

    <!-- 12. Cost Calculator CTA -->
    <CostVideo />

    <!-- 13. FAQ -->
    <QandASection
        questions={faqQuestions}
        title1="Everything You Need to Know"
        title2="About Monthly Retainers"
        description="From deliverables and turnaround times to revisions, content types, and changing priorities, here's how an ongoing EyesOn partnership works."
    />

    <!-- 14. Contact -->
    <ContactUs client:visible />

</main>
