        title : "Static Creatives",
        description : "Campaign graphics, social assets, promotional visuals, thumbnails, and supporting\n" +
            "designs when required.",
    },
]

const whyMonthly = [
    {
        id : 1,
        title : "Faster Production",
        description : "We already understand your brand, product, audience, references, and preferences—so\n" +
            "less time is wasted onboarding every project.",
    },
    {
        id : 2,
        title : "Consistent Quality",
        description : "Your content maintains the same visual language and production standard across\n" +
            "campaigns and platforms.",
    },
    {
        id : 3,
        title : "Predictable Output",
        description : "You know there is a creative team available every month instead of searching for\n" +
            "freelancers whenever something comes up.",
    },
    {
        id : 4,
        title : "Better Over Time",
        description : "Every project teaches us more about your brand, audience, and what performs—making\n" +
            "future production more efficient.",
    },
    {
        id : 5,
        title : "More Creative Testing",
        description : "Produce more hooks, concepts, formats, and variations instead of betting everything on\n" +
            "one creative.",
    },
    {
        id : 6,
        title : "Less Management",
        description : "One creative partner can replace the complexity of coordinating multiple editors,\n" +
            "animators, designers, and freelancers.",
    },
]

const whatWeHandle = [
    {
        id : 1,
        title : "Strategy & Concepts",
        description : "Content ideas, campaign directions, creative concepts, hooks, references, and visual\n" +
            "approaches.",
    },
    {
        id : 2,
        title : "Scriptwriting",
        description : "Short-form scripts, product messaging, ad copy, voiceover scripts, and narrative\n" +
            "structures.",
    },
    {
        id : 3,
        title : "Storyboarding",
        description : "Clear visual planning before complex productions begin.",
    },
    {
        id : 4,
        title : "Editing",
        description : "Professional editing, pacing, transitions, typography, footage integration, and finishing.",
    },
    {
        id : 5,
        title : "Motion Design",
        description : "2D motion, interface animation, graphic sequences, visual effects, and branded animation.",
    },
    {
        id : 6,
        title : "UI Animation",
        description : "Animated product screens, dashboards, applications, websites, workflows, and\n" +
            "interactions.",
    },
    {
        id : 7,
        title : "Sound Design",
        description : "Music, sound effects, transitions, mixing, and voiceover integration.",
    },
    {
        id : 8,
        title : "Creative Variations",
        description : "Different hooks, openings, CTAs, durations, formats, and campaign versions.",
    },
    {
        id : 9,
        title : "Final Delivery",
        description : "Production-ready assets optimized for the channels where they will be published.",
    },
]

const differentTeams = [
    {
        id : 1,
        title : "SaaS & AI Companies",
        description : "Keep product marketing moving with demos, feature content, launch videos, ads, and\n" +
            "social creative.",
    },
    {
        id : 2,
        title : "Startups",
        description : "Get consistent creative output without building a complete internal production\n" +
            "department.",
    },
    {
