---
import { SmartImage } from "../../utils/SmartImage";

type FeatureItem = {
  id: number;
  title: string;
  description: string;
  path: string;
  bgImageDesktop: string;
  bgImageMobile: string;
};

export type FeatureOverride = {
  id: number;
  title?: string | null;
  description?: string | null;
  path?: string | null;
  bgImageDesktop?: string | null;
  bgImageMobile?: string | null;
};

type Props = {
  title?: string;
  highlight?: string;
  description?: string;
  badgeText?: string;
  features?: FeatureOverride[];
  bgImageSrc?: string;
  bgImageAlt?: string;
  bgImageWidth?: number;
  bgImageHeight?: number;
};

const DEFAULT_FEATURES: FeatureItem[] = [
  {
    id: 1,
    title: "15-Second Free Sample Edit",
    description:
      "Send us your footage and we will create a free 15-second sample edit so you can preview\n" +
        "the pacing, structure, and editing style before committing to a full project.",
    path: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    bgImageDesktop: "/Shared/Features/1.webp",
    bgImageMobile: "/Shared/Features/mobile-vecs/shared.webp",
  },
  {
    id: 2,
    title: "Editing Built for Social Media",
    description:
      "We edit with platform behavior in mind, stronger hooks, tighter pacing, cleaner structure,\n" +
        "and better visual flow designed for YouTube, Instagram, TikTok, Reels, Shorts, and X.",
    path: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z",
    bgImageDesktop: "/Shared/Features/1.webp",
    bgImageMobile: "/Shared/Features/mobile-vecs/shared.webp",
  },
  {
    id: 3,
    title: "Built for Virality & Retention",
    description:
      "We study pacing, hooks, visual rhythm, captions, emotional payoff, and viewer behavior to\n" +
        "create content that feels more engaging, more watchable, and more likely to be shared.",
    path: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    bgImageDesktop: "/Shared/Features/1.webp",
    bgImageMobile: "/Shared/Features/mobile-vecs/shared.webp",
  },
  {
    id: 4,
    title: "Fast, Scalable Workflow",
    description:
      "From one-off videos to ongoing monthly content pipelines, our workflow is built to support\n" +
        "creators and brands that need consistent output without sacrificing quality.",
    path: "M13 10V3L4 14h7v7l9-11h-7z",
    bgImageDesktop: "/Shared/Features/1.webp",
    bgImageMobile: "/Shared/Features/mobile-vecs/shared.webp",
  },
  {
    id: 5,
    title: "Clear Communication",
    description:
      "No confusing revisions or disappearing freelancers. Every project follows a structured\n" +
        "workflow with organized feedback, updates, and reliable delivery timelines.",
    path: "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01",
    bgImageDesktop: "/Shared/Features/1.webp",
    bgImageMobile: "/Shared/Features/mobile-vecs/shared.webp",
  },
  {
    id: 6,
    title: "Trusted by Global Brands & Creators",
    description:
      "We work with creators, startups, SaaS teams, and modern brands across 25+ countries,\n" +
        "delivering content designed for today's fast-moving digital platforms.",
    path: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
    bgImageDesktop: "/Shared/Features/1.webp",
    bgImageMobile: "/Shared/Features/mobile-vecs/shared.webp",
  },
];

const defaultFeatureById = (id: number): FeatureItem | undefined =>
  DEFAULT_FEATURES.find((f) => f.id === id);

const {
  title = "Professional Editing That Makes Your Content Stand Out",
  highlight = "Built for Creators, Brands & Agencies",
  description = "From raw footage to polished content, we handle every step of the editing process with precision, creativity, and speed.",
  badgeText = "BUILT FOR MODERN CONTENT",
  features: featureOverrides = DEFAULT_FEATURES,
  bgImageSrc = "/animation-section/Edited-Chess.webp",
  bgImageAlt = "Edited Chess",
  bgImageWidth = 750,
  bgImageHeight = 500,
} = Astro.props as Props;

const features: FeatureItem[] = featureOverrides.map((override) => {
  const def = defaultFeatureById(override.id);
  return {
    id: override.id,
    title: override.title ?? def?.title ?? "",
    description: override.description ?? def?.description ?? "",
    path: override.path ?? def?.path ?? "",
    bgImageDesktop: override.bgImageDesktop ?? def?.bgImageDesktop ?? "",
    bgImageMobile: override.bgImageMobile ?? def?.bgImageMobile ?? "",
  };
});

// Mobile: group into slides of 3 (6 features -> 2 slides). Desktop ignores grouping.
const featureSlides: FeatureItem[][] = features.reduce<FeatureItem[][]>(
  (acc, feature, i) => {
    const slideIndex = Math.floor(i / 3);
    if (!acc[slideIndex]) acc[slideIndex] = [];
    acc[slideIndex].push(feature);
    return acc;
  },
  [],
);
---

<section
  class="relative w-full overflow-visible px-6 py-20 font-sans lg:px-16"
  data-features-section
>
  <p class="text-[11px] sm:text-sm tracking-widest text-white/60 font-semibold uppercase text-center w-full mb-6">
    {badgeText}
  </p>
  <div class="relative z-10 mx-auto flex max-w-7xl flex-col items-center">
    <div class="mb-16 max-w-3xl text-center">
      <SmartImage
        src={bgImageSrc}
        alt={bgImageAlt}
        width={bgImageWidth}
        height={bgImageHeight}
        className="pointer-events-none absolute -top-20 left-1/2 h-auto w-[290px] -translate-x-1/2 -z-1 md:-top-50 md:left-auto md:right-[21%] md:w-[750px] md:translate-x-0 [mask-image:linear-gradient(to_bottom,transparent_0%,black_50%,transparent_100%),linear-gradient(to_right,transparent_0%,black_50%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,transparent_0%,black_50%,transparent_100%),linear-gradient(to_right,transparent_0%,black_50%,transparent_100%)] [mask-composite:intersect] [-webkit-mask-composite:source-in]"
      />

      <h2
        class="mb-2 text-3xl leading-tight font-bold tracking-tight text-white md:text-4xl lg:text-[44px]"
      >
        {title}
      </h2>
      <h2
        class="mb-6 text-3xl font-bold tracking-tight text-[#42D1D1] md:text-4xl lg:text-[44px]"
      >
        {highlight}
      </h2>
      <p class="text-sm leading-relaxed text-gray-400 md:text-base">
        {description}
      </p>
    </div>

    <div
      class="feature-track grid w-full grid-cols-1 gap-10 md:gap-3 lg:grid-cols-3 mt-10"
      data-feature-track
    >
      {
        featureSlides.map((slide, slideIndex) => (
          <div
            class="feature-slide grid w-full grid-cols-1 gap-5 justify-center items-center"
            data-feature-slide-index={slideIndex}
          >
            {
              slide.map((feature, index) => (
                <article
                  class={`feature-card reveal-on-scroll spotlight-card relative group flex ${feature.id % 2 == 0 ? "right-3 sm:right-4.5 md:right-6 lg:right-0" : "left-3 sm:left-4.5 md:left-6 lg:left-0"} items-center md:items-start scale-[0.9] sm:scale-[1] justify-center md:justify-start w-[80%] min-h-fit sm:min-h-40 md:min-h-50 overflow-visible rounded-[24px] border border-white/5 bg-[#0A1A2A]/20 p-6 md:p-8 transition-[background-color,border-color] duration-300 hover:border-white/10 hover:bg-[#0A1A2A]/40 md:backdrop-blur-lg`}
                  data-feature-card-index={slideIndex * 3 + index}
                  data-reveal-delay={(index % 3) * 120}
                  style={`--bg-d: url(${feature.bgImageDesktop}); --bg-m: url(${feature.bgImageMobile});`}
                >
                  <img
                    src={`/Shared/Features/${feature.id}.svg`}
                    alt=""
                    class={`absolute scale-[1] sm:scale-[1.2] md:scale-[1.4] lg:scale-[1] ${feature.id % 2 == 0 ? "right-1 translate-x-1/2" : "left-1 -translate-x-1/2 "} -top-[9%] sm:-top-[10%] md:top-[10%] z-20 h-60 w-fit transition-transform duration-300 group-hover:scale-105 lg:left-1/2 lg:right-auto lg:-top-[5.75rem] lg:h-auto lg:w-[15rem] lg:scale-100 lg:z-30 lg:-translate-x-1/2`}
                    aria-hidden="true"
                  />
                  <div class="flex justify-start items-start flex-col w-[80%]">
                    {/* افکت نوری ملایم در هاور */}
                    <div class="pointer-events-none absolute inset-x-0 -bottom-10 z-0 h-32 bg-linear-to-t from-[#42D1D1]/10 to-transparent opacity-0 transition-opacity duration-500 blur-2xl group-hover:opacity-100" />

                    <div class="relative z-10 flex flex-col items-start justify-start md:items-start md:justify-start md:text-center md:top-6 md:left-10 lg:left-0">
                      {/* آیکون مینیمال شده */}


                      {/* متون مینیمال شده */}
                      <h3 class="mb-3 text-[16px] -mt-3 font-semibold tracking-wide text-white/95">
                        {feature.title}
                      </h3>
                      <p class="text-[14px] leading-[1.8] text-trim font-regular text-gray-200 group-hover:text-gray-300 transition-colors duration-300 line-clamp-4 sm:line-clamp-none">
                        {feature.description}
                      </p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        ))
      }
    </div>

    <div
      class="mt-6 flex items-center justify-center gap-2.5 md:hidden"
      data-feature-dots
    >
      {
        featureSlides.map((_slide, index) => (
          <button
            type="button"
            class={`feature-dot h-2 w-2 rounded-full transition-all duration-300 ${index === 0 ? "is-active" : ""}`}
            aria-label={`Go to slide ${index + 1}`}
            aria-pressed={index === 0 ? "true" : "false"}
            data-feature-dot-index={index}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (max-width: 1023px) {
    .feature-track {
      display: flex;
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      -ms-overflow-style: none;
      scrollbar-width: none;
      padding-top: 100px;
      padding-bottom: 1rem; /* برای جا باز کردن سایه‌ی کارت‌ها */
    }

    .feature-slide {
      scroll-snap-align: center;
      min-width: 85%;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
    }
  }

  .feature-card {
    background-image: var(--bg-m);
    background-size: cover;
    background-position: center;
    mix-blend-mode: overlay;
    background-blend-mode: overlay;
  }

  @media (min-width: 1024px) {
    .feature-track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .feature-slide {
      display: contents; /* بچه‌ها مستقیم داخل گرید ریختن، لوپ نیست */
    }

    /* دسکتاپ: کارت‌ها حالت اصلی / مثل قبل از تغییرات */
    .feature-card {
      /* از blend کردن کل کارت (که آیکون رو هم تحت تاثیر میذاشت) فاصله میگیریم؛
         به جاش تصویر رو با یک گرادیان تیره هم‌رنگ پس‌زمینه تیره می‌کنیم تا آیکون واضح و روی کارت باشه */
      background-image: linear-gradient(rgba(10, 26, 42, 0.45), rgba(10, 26, 42, 0.45)), var(--bg-d);
      background-size: cover;
      background-position: center;
      background-blend-mode: normal;
      mix-blend-mode: normal;
      display: block;
      width: 100%;
      min-height: 15rem;
      transition: transform 300ms ease, box-shadow 300ms ease;
    }

    /* متن: وسط‌چین و تمام‌عرض */
    .feature-card > div {
      display: block;
      width: 100%;
    }

    .feature-card > div > div {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .feature-card h3 {
      font-size: 19px;
    }

    .feature-card p {
      font-size: 14px;
    }

    .feature-card:hover {
      transform: translateY(-4px);
    }
  }

  .feature-dot {
    background: rgba(255, 255, 255, 0.15);
  }

  .feature-dot.is-active {
    background: #42D1D1;
    width: 1.25rem; /* نقطه فعال کشیده‌تر میشه (مینیمال‌تر از رنگ پررنگ) */
  }
</style>

<script>
  function initFeaturesCarousel() {
    const sections = document.querySelectorAll("[data-features-section]");

    sections.forEach((section) => {
      const track = section.querySelector("[data-feature-track]");
      const dotsWrap = section.querySelector("[data-feature-dots]");
      if (!(track instanceof HTMLElement) || !(dotsWrap instanceof HTMLElement))
        return;

      if (!window.matchMedia("(max-width: 1023px)").matches) return;

      const slides = Array.from(
        track.querySelectorAll("[data-feature-slide-index]"),
      );
      const dots = Array.from(
        dotsWrap.querySelectorAll("[data-feature-dot-index]"),
      );
      if (slides.length === 0 || dots.length === 0) return;

      const setActive = (index: number) => {
        dots.forEach((dot, i) => {
          const active = i === index;
          dot.setAttribute("aria-pressed", active ? "true" : "false");
          dot.classList.toggle("is-active", active);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const idx = Number(
              entry.target.getAttribute("data-feature-slide-index"),
            );
            if (!Number.isNaN(idx)) setActive(idx);
          });
        },
        { root: track, threshold: 0.6 },
      );

      slides.forEach((slide) => observer.observe(slide));

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const idx = Number(dot.getAttribute("data-feature-dot-index"));
          if (Number.isNaN(idx)) return;
          const slide = track.querySelector(
            `[data-feature-slide-index="${idx}"]`,
          );
          if (!(slide instanceof HTMLElement)) return;
          slide.scrollIntoView({
            behavior: "smooth",
            inline: "center",
            block: "nearest",
          });
        });
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initFeaturesCarousel);
  document.addEventListener("astro:page-load", initFeaturesCarousel);
</script>