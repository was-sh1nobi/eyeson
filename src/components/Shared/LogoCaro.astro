---
import { SmartImage } from "@/utils/SmartImage";

type Logo = { src: string; alt: string };

type Props = {
  tagline?: string;
  logos?: Logo[];
};

const {
  tagline = "Trusted by creators, startups, SaaS teams, and modern brands across 25+ countries.",
  logos = [
    { src: "/customers/crypto-elites.webp", alt: "Crypto Elites" },
    { src: "/customers/cryptosisty.webp", alt: "Cryptosity" },
    { src: "/customers/predctfy.webp", alt: "Predictefy" },
    { src: "/customers/kraken.webp", alt: "Kraken Team" },
    { src: "/customers/remora.webp", alt: "Remora" },
    { src: "/customers/hey-anon.webp", alt: "Hey Anon" },
    { src: "/customers/nexo.png", alt: "Nexo" },
  ],
} = Astro.props as Props;

// Quadruple logos for ultra-smooth, continuous tight loop
const loopLogos = [...logos, ...logos, ...logos, ...logos];
---

<section class="relative flex flex-col items-center gap-6 overflow-hidden pt-6 pb-2">
  <p class="text-center text-xs sm:text-sm font-medium tracking-wide text-white/70">{tagline}</p>

  <!-- ================= UNIFIED TIGHT MARQUEE ================= -->
  <div class="logo-mask w-full opacity-90" aria-label="Brand logos">
    <div class="logo-scroll flex w-max items-center">
      {
        loopLogos.map((logo, _index) => (
          <div class="logo-slot">
            <div class="logo-item group">
              <SmartImage
                src={logo.src}
                alt={logo.alt}
                width={84}
                height={84}
                loading="lazy"
                decoding="async"
                className="logo-img h-12 w-12 sm:h-14 sm:w-14 md:h-[56px] md:w-[56px] rounded-[50%] object-cover "
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
  }

  .logo-img {
    opacity: 0.9;
    transition: opacity 0.3s ease, transform 0.3s ease;
    will-change: opacity, transform;
  }

  .logo-item:hover .logo-img {
    opacity: 1;
    transform: scale(1.08);
  }

  /* ================= MARQUEE & MASK ================= */
  .logo-mask {
    --logo-gap: 0.5rem;
    overflow: hidden;

    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .logo-scroll {
    animation: logo-scroll-right 35s linear infinite;
    will-change: transform;
    gap: 0.75rem;
  }

  /* keep running on hover — do not pause */

  .logo-slot {
    flex: 0 0 auto;
    width: 130px;
  }

  @media (min-width: 640px) {
    .logo-slot {
      width: 160px;
    }
    .logo-scroll {
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .logo-slot {
      width: 180px;
    }
    .logo-scroll {
      gap: 1.5rem;
    }
  }

  @keyframes logo-scroll-right {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }
</style>
