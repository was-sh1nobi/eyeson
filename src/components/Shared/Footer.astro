---
import Section1 from "../FooterElements/Section1.astro";
import Section2 from "../FooterElements/Section2.astro";
import Section3 from "../FooterElements/Section3.astro";
import Section4 from "../FooterElements/Section4.astro";

// lucide icons (static, zero JS) — brand icons are local inline SVGs
import {
  ArrowRight,
  Mail,
  MapPin,
  Send,
  MessageCircle,
  ChevronDown,
} from "@lucide/astro";
import InstagramIcon from "../icons/InstagramIcon.astro";
import YoutubeIcon from "../icons/YoutubeIcon.astro";

const contentServices = [
  { label: "Short-Form Content", href: "/video" },
  { label: "Video Editing", href: "/video" },
  { label: "Monthly Retainers", href: "/retainers" },
  { label: "Ad Creative", href: "/adcreatives" },
  { label: "Content Production", href: "/portfolio" },
];

const serviceGroups = [
  {
    title: "Design Services",
    items: [
      { label: "Motion Graphics", href: "/motiongraphics" },
      { label: "Brand Identity", href: "/branding" },
      { label: "UI/UX Design", href: "/uiux" },
    ],
  },
  {
    title: "Animation Services",
    items: [
      { label: "Motion Graphics", href: "/motiongraphics" },
      { label: "2D/3D Animation", href: "/animation" },
      { label: "Motion Design", href: "/motiongraphics" },
    ],
  },
];

const socialLinks = [
  { label: "Instagram", href: "https://instagram.com/EyesonStudio" },
  { label: "YouTube", href: "https://youtube.com/@EyesonStudio" },
  { label: "Telegram", href: "https://t.me/EyesonStudio" },
  { label: "WhatsApp", href: "/contact" },
];
---

<div class="relative w-full">
  <!-- Background text -->
  <div
    class="absolute inset-0 hidden md:flex w-full h-full justify-center items-center pointer-events-none"
    style="z-index:1"
  >
    <h2
      class="font-bold text-[250px] leading-[100%] opacity-50 bg-linear-to-b from-[#00262B] to-[#00222B] text-transparent bg-clip-text"
    >
      Eyeson
    </h2>
  </div>

  <footer
    class="relative w-full bg-cover bg-center overflow-hidden text-white bg-linear-to-b from-[#000E17] to-[#006b7747]"
  >
    <div class="absolute inset-0 opacity-70 pointer-events-none">
      <div class="stars"></div>
      <div class="stars2"></div>
      <div class="stars3"></div>
    </div>
    <div
      class="container relative mx-auto px-6 py-16 md:py-20 lg:px-12 xl:px-16 z-10"
    >
      <!-- 📱 MOBILE -->
      <div class="flex flex-col md:hidden">
        <!-- Brand -->
        <div class="flex flex-col items-center gap-5 text-center">
          <img
            src="/logo.webp"
            alt="Eyeson logo"
            class="h-12 w-auto object-contain"
            loading="lazy"
          />
          <h2 class="max-w-xs text-lg font-medium text-white">
            Let's create something extraordinary together
          </h2>
        </div>

        <!-- Stay updated -->
        <div class="mt-10">
          <h3 class="text-center text-xs font-semibold tracking-[0.3em] text-[#46B6A0]">
            STAY UPDATED
          </h3>
          <form
            class="mt-4 flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 p-2 pl-4"
          >
            <label for="mobile-newsletter-email" class="sr-only">
              Your Email
            </label>
            <input
              id="mobile-newsletter-email"
              type="email"
              placeholder="Your Email"
              inputmode="email"
              autocomplete="email"
              class="min-w-0 flex-1 bg-transparent text-sm text-white placeholder:text-white/40 outline-none"
            />
            <button
              type="submit"
              aria-label="Subscribe to newsletter"
              class="grid h-11 w-11 shrink-0 cursor-pointer place-items-center rounded-xl bg-[#46B6A0] text-[#00131a] transition-colors duration-300 hover:bg-[#31d1a6]"
            >
              <ArrowRight class="h-5 w-5" stroke-width={2.5} />
            </button>
          </form>
          <div class="mt-3 text-center">
            <a
              href="/privacy"
              class="text-xs text-white/60 underline decoration-white/40 underline-offset-2 transition-colors duration-300 hover:text-[#46B6A0]"
            >
              Privacy Policy
            </a>
          </div>
        </div>

        <!-- Socials -->
        <div class="mt-8 flex justify-center gap-4">
          {socialLinks.map(({ label, href }) => (
            <a
              href={href}
              aria-label={label}
              {...href.startsWith("http") ? { target: "_blank", rel: "noreferrer" } : {}}
              class={`grid h-12 w-12 place-items-center rounded-full border border-white/10 bg-white/5 text-white transition-colors duration-300 ${
                label === "Instagram" ? "hover:text-[#E1306C]"
                : label === "YouTube" ? "hover:text-red-500"
                : label === "Telegram" ? "hover:text-[#0088cc]"
                : "hover:text-[#25D366]"
              }`}
            >
              {label === "Instagram" && <InstagramIcon class="h-[22px] w-[22px]" size={22} />}
              {label === "YouTube" && <YoutubeIcon class="h-[22px] w-[22px]" size={22} />}
              {label === "Telegram" && <Send class="h-[22px] w-[22px]" size={22} />}
              {label === "WhatsApp" && <MessageCircle class="h-[22px] w-[22px]" size={22} />}
            </a>
          ))}
        </div>

        <!-- Contact -->
        <div class="mt-10 flex flex-col items-center gap-4 text-sm text-white/90">
          <a
            href="https://instagram.com/EyesonStudio"
            target="_blank"
            rel="noreferrer"
            class="flex items-center gap-3 transition-colors duration-300 hover:text-[#46B6A0]"
          >
            <InstagramIcon class="h-5 w-5 text-[#46B6A0]" size={20} />
            <span>@EyesonStudio</span>
          </a>
          <a
            href="mailto:hello@eyesonstudio.com"
            class="flex items-center gap-3 transition-colors duration-300 hover:text-[#46B6A0]"
          >
            <Mail class="h-5 w-5 text-[#46B6A0]" size={20} />
            <span>hello@eyesonstudio.com</span>
          </a>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Tbilisi%2C%20Georgia"
            target="_blank"
            rel="noreferrer"
            class="flex items-start gap-3 text-center transition-colors duration-300 hover:text-[#46B6A0]"
          >
            <MapPin
              class="mt-0.5 h-5 w-5 shrink-0 text-[#46B6A0]"
              size={20}
            />
            <span class="max-w-[15rem]">
              Tbilisi, Georgia, Remote studio, working with clients worldwide
            </span>
          </a>
        </div>

        <!-- Services accordion -->
        <div class="mt-10 w-full border-t border-white/10">
          <details class="group border-b border-white/10">
            <summary
              class="flex list-none cursor-pointer items-center justify-between py-4 text-sm font-semibold text-white transition-colors duration-300 hover:text-[#46B6A0] [&::-webkit-details-marker]:hidden"
            >
              Content Services
              <ChevronDown
                class="h-4 w-4 text-white/60 transition-transform duration-300 group-open:rotate-180"
                size={16}
              />
            </summary>
            <ul class="flex flex-col gap-3 pb-5 text-sm text-white/70">
              {contentServices.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="cursor-pointer transition-colors duration-300 hover:text-[#46B6A0]"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>

          {serviceGroups.map((group) => (
            <details class="group border-b border-white/10">
              <summary
                class="flex list-none cursor-pointer items-center justify-between py-4 text-sm font-semibold text-white transition-colors duration-300 hover:text-[#46B6A0] [&::-webkit-details-marker]:hidden"
              >
                {group.title}
                <ChevronDown
                  class="h-4 w-4 text-white/60 transition-transform duration-300 group-open:rotate-180"
                  size={16}
                />
              </summary>
              <ul class="flex flex-col gap-3 pb-5 text-sm text-white/70">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="cursor-pointer transition-colors duration-300 hover:text-[#46B6A0]"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>

        <!-- Legal -->
        <div
          class="mt-8 flex flex-col items-center gap-4 border-t border-white/10 pt-6 text-center"
        >
          <p class="text-xs text-white/60">
            &copy; {new Date().getFullYear()} EyesOn Agency. All rights
            reserved.
          </p>
          <div class="flex gap-6 text-xs text-white/60">
            <a
              href="/privacy"
              class="transition-colors duration-300 hover:text-[#46B6A0]"
            >
              Privacy Policy
            </a>
            <a
              href="/privacy"
              class="transition-colors duration-300 hover:text-[#46B6A0]"
            >
              Terms of Service
            </a>
          </div>
        </div>
      </div>

      <!-- 💻 DESKTOP -->
      <div
        class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 lg:gap-x-12 xl:gap-x-16 justify-items-start"
      >
        <div class="w-full flex flex-col items-start">
          <Section1 />
        </div>

        <div class="w-full flex flex-col items-start">
          <Section2 />
        </div>

        <div class="w-full flex flex-col items-start">
          <Section3 />
        </div>

        <div class="w-full flex flex-col items-start">
          <Section4 />
        </div>
      </div>

      <!-- Divider -->
      <div class="hidden md:block w-full h-px bg-white/10 my-10 md:my-14"></div>

      <!-- Bottom -->
      <div
        class="hidden md:flex w-full flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left"
      >
        <h3
          class="text-xs md:text-sm text-gray-400 hover:text-white transition-colors duration-300"
        >
          &copy; {new Date().getFullYear()} EyesOn Agency. All rights reserved.
        </h3>

        <div class="flex gap-6 text-xs md:text-sm text-gray-400">
            <a href="/privacy" class="hover:text-white transition-colors">
              Privacy Policy
            </a>
            <a href="/terms" class="hover:text-white transition-colors">
            Terms of Service
          </a>
        </div>
      </div>
    </div>
  </footer>
</div>
<style>
  .stars,
  .stars2,
  .stars3 {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-repeat: repeat;
  }

  .stars {
    background-image:
      radial-gradient(
        2px 2px at 20px 30px,
        rgba(255, 255, 255, 0.9),
        transparent
      ),
      radial-gradient(
        1px 1px at 120px 80px,
        rgba(255, 255, 255, 0.7),
        transparent
      ),
      radial-gradient(
        1.5px 1.5px at 200px 150px,
        rgba(0, 169, 189, 0.8),
        transparent
      ),
      radial-gradient(
        2px 2px at 300px 40px,
        rgba(255, 255, 255, 0.8),
        transparent
      );
    background-size: 350px 350px;
    animation: starsMove 90s linear infinite;
  }

  .stars2 {
    background-image:
      radial-gradient(
        1px 1px at 50px 60px,
        rgba(255, 255, 255, 0.6),
        transparent
      ),
      radial-gradient(
        2px 2px at 180px 120px,
        rgba(0, 169, 189, 0.7),
        transparent
      ),
      radial-gradient(
        1.5px 1.5px at 250px 220px,
        rgba(255, 255, 255, 0.7),
        transparent
      );
    background-size: 500px 500px;
    animation: starsMove 140s linear infinite reverse;
    opacity: 0.7;
  }

  .stars3 {
    background-image:
      radial-gradient(
        2px 2px at 100px 200px,
        rgba(255, 255, 255, 0.5),
        transparent
      ),
      radial-gradient(
        1px 1px at 220px 100px,
        rgba(0, 169, 189, 0.6),
        transparent
      );
    background-size: 700px 700px;
    animation: starsMove 200s linear infinite;
    opacity: 0.5;
  }

  @keyframes starsMove {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-200px);
    }
  }
</style>
