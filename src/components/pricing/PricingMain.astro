---
import StarBackground from "../../islands/StarBackground.tsx";
import HomeBackground from "../Home/HomeBackground.astro";
import {PricingHero} from "../../islands/pricing/components/PricingHero.tsx";
import {ConversionScroll} from "../../islands/pricing/components/ConversionScroll.tsx";

import {MoneyCards} from "../../islands/pricing/components/MoneyCards.tsx";
import DesignCard from "./components/DesignCard.astro";
import QandASection from "../Shared/QandASection.astro";
import FinalCta from "@/islands/Shared/FinalCta";

---






<div class="relative overflow-x-clip  ">
    <HomeBackground />
    <PricingHero client:idle/>
    <MoneyCards client:idle/>
    <ConversionScroll client:visible/>
    <DesignCard />

    <QandASection />
    <FinalCta
      client:visible
      kicker="READY TO START?"
      title="Ready to make your product clear?"
      description="Let's turn complexity into conversion."
      primaryText="Book a Call"
      primaryHref="/contact"
      secondaryText="Get Pricing"
      secondaryHref="/pricing"
    />
</div>
