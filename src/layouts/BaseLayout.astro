---
import Header from "../islands/Shared/MegaMenu.tsx";
import Footer from "../components/Shared/Footer.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  lang?: string;
  keywords?: string;
  datePublished?: string;
  dateModified?: string;
  articleSection?: string;
  heroImage?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = "/og/image.jpg",
  ogType = "website",
  robots,
  lang = "en",
  keywords,
  datePublished,
  dateModified,
  articleSection,
  heroImage,
} = Astro.props as Props;

const defaultTitle = () => {
  const path = Astro.url.pathname.replace(/^\//, "").replace(/\/$/, "");
  if (!path) return "EyesOn Studio — Motion Design & Creative Agency";
  const parts = path.split("/").map((p) => p.charAt(0).toUpperCase() + p.slice(1));
  return `${parts.join(" ")} — EyesOn Studio`;
};

const computedTitle = title ?? defaultTitle();
const computedDescription = description ?? "EyesOn Studio — Motion Design & Creative Agency";


const finalTitle = title ?? computedTitle;
const finalDescription = description ?? computedDescription;

const siteUrl = "https://eyesonstudio.com";
const absoluteOgImage = ogImage?.startsWith("http") ? ogImage : new URL(ogImage, siteUrl).href;
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const heroImageType = heroImage?.endsWith(".svg")
  ? "image/svg+xml"
  : heroImage?.endsWith(".jpg") || heroImage?.endsWith(".jpeg")
    ? "image/jpeg"
    : "image/webp";
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <meta name="theme-color" content="#000E17" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/webp" href="/logo.webp" />

    <!-- Fonts: shared site identity only -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400..800&family=Inter:wght@400..700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400..800&family=Inter:wght@400..700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400..800&family=Inter:wght@400..700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <script is:inline>
      (function(){
        try {
          document.documentElement.classList.add('js');
          var gpuOff = false;
          // WebGL probe — fails when GPU acceleration off or swiftshader disabled
          try {
            var c = document.createElement('canvas');
            var gl = c.getContext('webgl') || c.getContext('experimental-webgl');
            if (!gl) gpuOff = true;
            else {
              var dbg = gl.getExtension('WEBGL_debug_renderer_info');
              if (dbg) {
                var r = gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) || '';
                if (/swiftshader|software|llvmpipe|basic render/i.test(r)) gpuOff = true;
              }
            }
          } catch(e) { gpuOff = true; }
          // Low-power fallback: save-data, few cores, tiny device memory, or
          // coarse-pointer small screens all run blurs/GSAP on CPU → jank.
          try {
            var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
            if (conn && (conn.saveData === true || /^(slow-2g|2g)$/.test(conn.effectiveType || ''))) gpuOff = true;
            if (typeof navigator.hardwareConcurrency === 'number' && navigator.hardwareConcurrency <= 4) {
              var dm = navigator.deviceMemory;
              if (typeof dm !== 'number' || dm <= 4) {
                if (window.matchMedia('(pointer: coarse)').matches && Math.min(screen.width, screen.height) < 820) gpuOff = true;
              }
            }
          } catch(e) {}
          if (gpuOff) document.documentElement.classList.add('gpu-off');
          // Reduced motion is separate from GPU-off: it disables motion but
          // must NOT hide scroll reveals (see microInteractions + global.css).
          var reduced = false;
          try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch(e) {}
          if (reduced) document.documentElement.classList.add('reduce-motion');
          // expose for Lenis / island gates
          window.__GPU_OFF__ = gpuOff;
          window.__REDUCED_MOTION__ = reduced;
        } catch(e){}
      })();
    </script>
    <link rel="canonical" href={resolvedCanonical} />
    {robots && <meta name="robots" content={robots} />}
    {heroImage && <link rel="preload" as="image" type={heroImageType} href={heroImage} fetchpriority="high" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={resolvedCanonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:site" content="@eyesonstudio" />
    <meta name="twitter:creator" content="@eyesonstudio" />

    {keywords && <meta name="keywords" content={keywords} />}
    {ogType === "article" && <meta name="author" content="EyesOn Studio" />}
    <meta name="format-detection" content="telephone=no, email=no" />

    {datePublished && <meta property="article:published_time" content={datePublished} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}
    {articleSection && <meta property="article:section" content={articleSection} />}

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "EyesOn Studio",
      "url": "https://eyesonstudio.com",
      "logo": "https://eyesonstudio.com/og/image.jpg",
      "description": "Motion Design & Creative Agency",
      "sameAs": [
        "https://twitter.com/eyesonstudio",
        "https://www.linkedin.com/company/eyesonstudio"
      ]
    })} />
  </head>

  <body class="bg-[#000E17] text-white overflow-x-hidden" transition:animate="fade">
    <Header client:idle />

    <main class="min-w-0 overflow-x-hidden">
      <slot />
    </main>

    <Footer />

    <script>
      import "../utils/microInteractions.ts";
    </script>

    <script>
      import type Lenis from "lenis";

      const isMobile = typeof window !== 'undefined' && window.matchMedia('(max-width: 1024px)').matches;
      const isFirefox = navigator.userAgent.toLowerCase().includes('firefox');
      const prefersReduced = typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const gpuOff = typeof window !== 'undefined' && (document.documentElement.classList.contains('gpu-off') || (window as any).__GPU_OFF__);

      // Only run Lenis on desktop non-Firefox with GPU — native scroll when GPU off to avoid CPU jank
      if (!isFirefox && !isMobile && !prefersReduced && !gpuOff) {
        let lenis: Lenis;
        let rafId = 0;

        async function initSmoothScrolling() {
          if (lenis) lenis.destroy();
          if (rafId) cancelAnimationFrame(rafId);

          const Lenis = (await import('lenis')).default;

          lenis = new Lenis({
            duration: 1.0,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
            wheelMultiplier: 1,
            touchMultiplier: 1.5,
            gestureOrientation: 'vertical',
          });

          function raf(time: number) {
            lenis.raf(time);
            rafId = requestAnimationFrame(raf);
          }

          rafId = requestAnimationFrame(raf);
        }

        const deferIdle = (cb: IdleRequestCallback) => (window.requestIdleCallback ? window.requestIdleCallback(cb, { timeout: 2000 }) : setTimeout(cb, 600));
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => deferIdle(initSmoothScrolling), { once: true });
        } else {
          deferIdle(initSmoothScrolling);
        }

        document.addEventListener('astro:page-load', () => deferIdle(initSmoothScrolling));
      }
    </script>

    <script is:inline>
      (function(){
        var run=function(){
          var endpoint='/api/analytics/receive/v1';
          try{
            var body=JSON.stringify({event:'pageview',path:location.pathname,userAgent:navigator.userAgent});
            var sent=navigator.sendBeacon(endpoint,new Blob([body],{type:'application/json'}));
            if(!sent) fetch(endpoint,{method:'POST',body:body,headers:{'Content-Type':'application/json'},keepalive:true}).catch(function(){});
          }catch(e){}
          fetch('/api/client-ip').then(function(r){return r.json();}).then(function(data){
            var ip=data.ip||'';var raw=ip+'|'+navigator.userAgent;var h=0;
            for(var i=0;i<raw.length;i++){var c=raw.charCodeAt(i);h=((h<<5)-h)+c;h|=0;}
            try{navigator.sendBeacon(endpoint,new Blob([JSON.stringify({event:'pageview',hash:Math.abs(h).toString(36),path:location.pathname,userAgent:navigator.userAgent})],{type:'application/json'}));}catch(e){}
          }).catch(function(){});
        };
        if('requestIdleCallback' in window) requestIdleCallback(run,{timeout:4000}); else setTimeout(run,1400);
      })();
    </script>


    <style is:global>
      
      ::-webkit-scrollbar {
        width: 10px;
      }

      ::-webkit-scrollbar-track {
        background: #183945; 
      }

      ::-webkit-scrollbar-thumb {
        background: linear-gradient(to bottom, #31d1a6, #25aeb2);
        border-radius: 8px;
        border: 2px solid #183945; 
      }

      ::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(to bottom, #31d1a6, #31d1a6);
      }

      /* --- استایل اسکرول‌بار برای فایرفاکس --- */
      * {
        scrollbar-width: thin;
        scrollbar-color: #31d1a6 #183945;
      }

      /* --- استایل‌های ضروری برای عملکرد درست Lenis --- */
      html.lenis {
        scroll-behavior: auto;
      }

      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }

      .lenis.lenis-stopped {
        overflow: hidden;
      }

      .lenis.lenis-smooth iframe {
        pointer-events: none;
      }
    </style>
  </body>
</html>
